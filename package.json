{
  "name": "skill-tracker",
  "author": "Mitul Patel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "sync:disciplines": "node scripts/sync-disciplines.mjs",
    "data:check": "node scripts/validate-data.mjs",
    "data:audit": "node scripts/audit-data.mjs",
    "docker:dev": "docker compose up dev",
    "docker:build": "docker build -t skill-tracker .",
    "docker:run": "docker run --rm -p 3000:3000 skill-tracker",
    "docker:up": "docker compose up -d prod",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "isbot": "^5.1.36",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.14.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
